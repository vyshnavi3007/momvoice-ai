# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file anywhere public.

# From BotFather when you created your Telegram bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Your Google Cloud project ID
GOOGLE_CLOUD_PROJECT=momvoice-ai
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# The model your agents use. Start with a Gemini model to get things
# working, then switch to a Gemma Model Garden endpoint once deployed.
MODEL_NAME=gemini-2.0-flash

# Cloud SQL connection info
# Find this in Console > SQL > your instance > "Connection name"
# It looks like: project-id:region:instance-id
INSTANCE_CONNECTION_NAME=momvoice-ai:us-central1:momvoice-db
DB_USER=postgres
DB_PASS=the-password-you-generated-and-saved
DB_NAME=postgres
